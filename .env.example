# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database backend.
#   Local dev: leave as "false" (uses data/db.json, zero setup).
#   Vercel production: MUST be "true" — the serverless filesystem is
#   read-only, so file writes fail. First run supabase/schema.sql (v5)
#   once in the Supabase SQL Editor, then set this to "true".
USE_SUPABASE_DB=false

# Public URL of the site (used for links inside emails + SEO)
# Local: http://localhost:3000
# Vercel: https://jiri-bakes.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# EMAIL (automatic order confirmations via SMTP)
# ============================================================
# Recommended provider: Gmail SMTP.
#   1. Turn on 2-Step Verification for the Gmail account
#      (https://myaccount.google.com/security)
#   2. Create an "App Password": Settings → Security → 2-Step
#      Verification → App passwords → generate one.
#   3. Put that 16-character app password in SMTP_PASS below.
# SMTP_USER and SMTP_PASS are REQUIRED to enable email.
# If they are missing, orders are still saved but no email is sent.
# 465 = implicit TLS (default); 587 = STARTTLS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourname@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME=Jiri Bakes
SMTP_FROM_EMAIL=yourname@gmail.com
# Comma-separated addresses that receive a staff alert on every new order.
# If empty, the fallback is the site's contact email (settings.email).
SMTP_NOTIFY_TO=you@example.com

# ============================================================
# VERCEL DEPLOY CHECKLIST (https://jiri-bakes.vercel.app)
# 1. Run supabase/schema.sql (v4+) in Supabase SQL Editor (idempotent).
# 2. Vercel → Project → Settings → Environment Variables: add ALL vars
#    from this file, with:
#      USE_SUPABASE_DB=true
#      NEXT_PUBLIC_SITE_URL=https://jiri-bakes.vercel.app
# 3. Redeploy, then open /api/health — expect backend=supabase,
#    smtp=true, auth=true, siteUrl=https://jiri-bakes.vercel.app
# 4. Test: place an order → staff + customer emails → /track?id=...
#    → admin login → status change emails customer.
# ============================================================
